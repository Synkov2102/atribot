# Токен от @BotFather
BOT_TOKEN=

# Сколько секунд даётся на ответ (10–3600)
CAPTCHA_TIMEOUT_SEC=120

# Сколько попыток даётся на ответ (меньше, чем вариантов)
CAPTCHA_MAX_ATTEMPTS=1

# Сколько вариантов ответа показывать (2–12)
CAPTCHA_OPTIONS=8

# На сколько секунд не пускать обратно после провала (минимум 31)
KICK_BAN_SEC=300
